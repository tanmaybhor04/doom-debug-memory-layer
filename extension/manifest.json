{
  "manifest_version": 3,
  "name": "Memory Layer",
  "version": "0.2",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "http://localhost:8000/*"
  ],
  "action": { "default_popup": "popup.html", "default_title": "Memory Layer" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": [
      "https://chatgpt.com/*",
      "https://claude.ai/*",
      "https://gemini.google.com/*"
    ],
    "js": ["content.js"]
  }]
}